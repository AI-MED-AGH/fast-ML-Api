# EXAMPLE ONLY - not an active workflow. Copy to .github/workflows/build-and-push.yml
# and adapt the registry, image name and credentials to your environment.
name: build-and-push-example

on:
  push:
    tags: ["v*"]

env:
  REGISTRY: registry.example.com        # <- your container registry
  IMAGE_NAME: my-org/my-model           # <- your image name

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - uses: docker/setup-buildx-action@v3
      - uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ secrets.REGISTRY_USERNAME }}
          password: ${{ secrets.REGISTRY_PASSWORD }}
      - uses: docker/build-push-action@v6
        with:
          context: .
          file: examples/containerized/Dockerfile
          push: true
          tags: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ github.ref_name }}
